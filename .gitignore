# Ignore everything by default
*

# Keep the ignore file itself
!.gitignore

# Whitelist specific top-level config dirs (and all contents)
!hypr/
!hypr/**

!waybar/
!waybar/**

!alacritty/
!alacritty/**

!nvim/
!nvim/**

!walker/
!walker/**

# If you track Aseprite build/config under .config
!aseprite/
!aseprite/**

# Allow .local/share/applications (parents must be un-ignored first)
!.local/
!.local/share/
!.local/share/applications/
!.local/share/applications/**

# Package lists for reproducible setup
!pkglist.txt
!aurlist.txt

